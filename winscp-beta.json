{
  "version": "6.6.4-rc",
  "homepage": "https://sourceforge.net/projects/winscp/files/WinSCP/",
  "url": "https://downloads.sourceforge.net/project/winscp/WinSCP/6.6.4%20RC/WinSCP-6.6.4.RC-Portable.zip",
  "hash": "321DDAF8CB49C9E50E8EAA7B20AF5CB45F5AE2A324EF4109BAE21F132C051124",
  "pre_install": [
    "if (!(Test-Path \"$persist_dir\\winscp.ini\")) {",
    "    @(",
    "        '[Configuration\\Interface]'",
    "        'RandomSeedFile=.\\winscp.rnd'",
    "    ) | Add-Content -Path \"$dir\\winscp.ini\" -Encoding ASCII -Force",
    "}"
  ],
  "bin": [
    "WinSCP.exe",
    [
      "WinSCP.com",
      "WinSCP-cli"
    ]
  ],
  "shortcuts": [
    [
      "WinSCP.exe",
      "WinSCP"
    ]
  ],
  "persist": "winscp.ini"
}
