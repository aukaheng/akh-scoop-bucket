{
  "version": "6.6.7",
  "homepage": "https://sourceforge.net/projects/winscp/files/WinSCP/",
  "url": "https://downloads.sourceforge.net/project/winscp/WinSCP/6.7/WinSCP-6.7-Portable-x64-Experimental.zip",
  "hash": "47565F1E22557131762F3122D6646CBCE76910305A9A839EB77AE757FCAC4FAF",
  "pre_install": [
    "if (!(Test-Path \"$persist_dir\\winscp.ini\")) {",
    "    @(",
    "        '[Configuration\\Interface]'",
    "        'RandomSeedFile=.\\winscp.rnd'",
    "    ) | Add-Content -Path \"$dir\\winscp.ini\" -Encoding ASCII -Force",
    "}"
  ],
  "bin": [
    "WinSCP.exe",
    [
      "WinSCP.com",
      "WinSCP-cli"
    ]
  ],
  "shortcuts": [
    [
      "WinSCP.exe",
      "WinSCP"
    ]
  ],
  "persist": "winscp.ini"
}
